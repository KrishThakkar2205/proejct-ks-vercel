{
  "appId": "com.influrunner.app",
  "appName": "InfluRunner",
  "webDir": "dist",
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "automatic"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#FF6B1A",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
